# Copy to .env and fill in. Only GEMINI_API_KEY is required.
#
# Reasoning. Free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Voice input (bonus). Whisper transcription, free tier at https://console.groq.com
# Without it, voice falls back to Gemini transcription, which is markedly worse
# at Hebrew - see ADR-0016.
GROQ_API_KEY=

# Voice output fallback (optional). Used only when the browser refuses to speak.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
